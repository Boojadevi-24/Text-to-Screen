import torch
from diffusers import DiffusionPipeline
import imageio
import os
from realesrgan import RealESRGAN
import gdown

os.makedirs("weights", exist_ok=True)
gdown.download("https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4.pth", "weights/RealESRGAN_x4.pth", quiet=False)

model_id = "damo-vilab/text-to-video-ms-1.7b"
pipe = DiffusionPipeline.from_pretrained(model_id, torch_dtype=torch.float16, variant="fp16")
pipe = pipe.to("cuda")

prompt = "A robot dancing in the rain in a futuristic city at night"
video_frames = pipe(prompt, num_frames=16, height=256, width=256).frames

os.makedirs("outputs", exist_ok=True)
low_res_path = "outputs/generated_video.mp4"
imageio.mimsave(low_res_path, video_frames, fps=8)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
upscaler = RealESRGAN(device, scale=4)
upscaler.load_weights("weights/RealESRGAN_x4.pth")

upscaled_frames = []
for frame in video_frames:
    upscaled_frame = upscaler.predict(frame)
    upscaled_frames.append(upscaled_frame)

high_res_path = "outputs/generated_video_upscaled.mp4"
imageio.mimsave(high_res_path, upscaled_frames, fps=8)

print(f"Low-res video saved at: {low_res_path}")
print(f"High-res video saved at: {high_res_path}")
